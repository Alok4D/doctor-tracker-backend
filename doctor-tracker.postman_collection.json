{
  "info": {
    "_postman_id": "doctor-tracker-api-collection",
    "name": "Doctor Tracker API Collection",
    "description": "Complete REST API collection for Care Guide BD Doctor Tracker Hospital Admin System.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "doctorId",
      "value": "",
      "type": "string"
    },
    {
      "key": "patientId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Authentication",
      "item": [
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.success && response.data.accessToken) {",
                  "    pm.collectionVariables.set('token', response.data.accessToken);",
                  "    console.log('Token saved:', response.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@doctor-tracker.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Current Admin Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "02. Doctors",
      "item": [
        {
          "name": "Get All Doctors (Search, Filter & Paginate)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/doctors?page=1&limit=10&searchTerm=&specialization=all",
              "host": ["{{baseUrl}}"],
              "path": ["doctors"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "searchTerm", "value": "" },
                { "key": "specialization", "value": "all" }
              ]
            }
          }
        },
        {
          "name": "Get Single Doctor By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/doctors/{{doctorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["doctors", "{{doctorId}}"]
            }
          }
        },
        {
          "name": "Create New Doctor",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dr. Emily Watson\",\n  \"specialization\": \"Cardiologist\",\n  \"hospital\": \"Square Hospital\",\n  \"phone\": \"+880 1711 998877\",\n  \"email\": \"emily.watson@hospital.com\",\n  \"status\": \"Active\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/doctors",
              "host": ["{{baseUrl}}"],
              "path": ["doctors"]
            }
          }
        },
        {
          "name": "Get Corresponding Patients for Doctor (PDF Page 2)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/doctors/{{doctorId}}/patients",
              "host": ["{{baseUrl}}"],
              "path": ["doctors", "{{doctorId}}", "patients"]
            }
          }
        },
        {
          "name": "Add Patient Under Specific Doctor (PDF Page 2)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Karim Ullah\",\n  \"age\": 45,\n  \"gender\": \"Male\",\n  \"condition\": \"Hypertension\",\n  \"phone\": \"+880 1819 001122\",\n  \"status\": \"Admitted\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/doctors/{{doctorId}}/patients",
              "host": ["{{baseUrl}}"],
              "path": ["doctors", "{{doctorId}}", "patients"]
            }
          }
        },
        {
          "name": "Delete Patient from Doctor's List (PDF Page 2)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/doctors/{{doctorId}}/patients/{{patientId}}",
              "host": ["{{baseUrl}}"],
              "path": ["doctors", "{{doctorId}}", "patients", "{{patientId}}"]
            }
          }
        },
        {
          "name": "Update Doctor",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+880 1711 000111\",\n  \"status\": \"Active\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/doctors/{{doctorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["doctors", "{{doctorId}}"]
            }
          }
        },
        {
          "name": "Delete Doctor",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/doctors/{{doctorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["doctors", "{{doctorId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "03. Patients",
      "item": [
        {
          "name": "Get All Patients (Master list, search & filters)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/patients?page=1&limit=10&condition=all&status=all",
              "host": ["{{baseUrl}}"],
              "path": ["patients"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "condition", "value": "all" },
                { "key": "status", "value": "all" }
              ]
            }
          }
        },
        {
          "name": "Get Single Patient By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/patients/{{patientId}}",
              "host": ["{{baseUrl}}"],
              "path": ["patients", "{{patientId}}"]
            }
          }
        },
        {
          "name": "Register New Patient",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mahmud Hasan\",\n  \"age\": 38,\n  \"gender\": \"Male\",\n  \"condition\": \"Diabetes Type 2\",\n  \"phone\": \"+880 1822 334455\",\n  \"doctorId\": \"{{doctorId}}\",\n  \"status\": \"Admitted\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/patients",
              "host": ["{{baseUrl}}"],
              "path": ["patients"]
            }
          }
        },
        {
          "name": "Update Patient",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"condition\": \"Diabetes Type 2 - Controlled\",\n  \"status\": \"Followup\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/patients/{{patientId}}",
              "host": ["{{baseUrl}}"],
              "path": ["patients", "{{patientId}}"]
            }
          }
        },
        {
          "name": "Delete Patient",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/patients/{{patientId}}",
              "host": ["{{baseUrl}}"],
              "path": ["patients", "{{patientId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "04. Dashboard & Analytics",
      "item": [
        {
          "name": "Get Dashboard Statistics (KPIs)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/dashboard/stats",
              "host": ["{{baseUrl}}"],
              "path": ["dashboard", "stats"]
            }
          }
        },
        {
          "name": "Get Patients Overview Trend",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/dashboard/patients-overview",
              "host": ["{{baseUrl}}"],
              "path": ["dashboard", "patients-overview"]
            }
          }
        },
        {
          "name": "Get Doctors by Specialty Breakdown",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/dashboard/specialty-stats",
              "host": ["{{baseUrl}}"],
              "path": ["dashboard", "specialty-stats"]
            }
          }
        },
        {
          "name": "Get Patients per Doctor Analytics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/dashboard/patients-per-doctor",
              "host": ["{{baseUrl}}"],
              "path": ["dashboard", "patients-per-doctor"]
            }
          }
        }
      ]
    }
  ]
}

