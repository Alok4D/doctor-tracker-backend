{
  "info": {
    "_postman_id": "doctor-tracker-api-collection",
    "name": "Doctor Tracker API Collection",
    "description": "Complete REST API collection for Care Guide BD Doctor Tracker Hospital Admin System.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "doctorId",
      "value": "",
      "type": "string"
    },
    {
      "key": "patientId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Authentication",
      "item": [
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.success && response.data.accessToken) {",
                  "    pm.collectionVariables.set('token', response.data.accessToken);",
                  "    console.log('Token saved:', response.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@doctor-tracker.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Current Admin Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "02. Doctors",
      "item": [
        {
          "name": "Get All Doctors (Search, Filter & Paginate)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/doctors?page=1&limit=10&searchTerm=&specialization=all",
              "host": ["{{baseUrl}}"],
              "path": ["doctors"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "searchTerm", "value": "" },
                { "key": "specialization", "value": "all" }
              ]
            }
          }
        },
        {
          "name": "Get Single Doctor By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/doctors/{{doctorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["doctors", "{{doctorId}}"]
            }
          }
        },
        {
          "name": "Create New Doctor",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "Dr. Emily Watson", "type": "text" },
                { "key": "specialization", "value": "Cardiologist", "type": "text" },
                { "key": "hospital", "value": "Square Hospital", "type": "text" },
                { "key": "phone", "value": "+880 1711 998877", "type": "text" },
                { "key": "email", "value": "emily.watson@hospital.com", "type": "text" },
                { "key": "status", "value": "Active", "type": "text" },
                { "key": "photo", "type": "file", "src": [], "disabled": true }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/doctors",
              "host": ["{{baseUrl}}"],
              "path": ["doctors"]
            }
          }
        },
        {
          "name": "Get Corresponding Patients for Doctor (PDF Page 2)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/doctors/{{doctorId}}/patients",
              "host": ["{{baseUrl}}"],
              "path": ["doctors", "{{doctorId}}", "patients"]
            }
          }
        },
        {
          "name": "Add Patient Under Specific Doctor (PDF Page 2)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "Karim Ullah", "type": "text" },
                { "key": "age", "value": "45", "type": "text" },
                { "key": "gender", "value": "Male", "type": "text" },
                { "key": "condition", "value": "Hypertension", "type": "text" },
                { "key": "phone", "value": "+880 1819 001122", "type": "text" },
                { "key": "status", "value": "Admitted", "type": "text" },
                { "key": "photo", "type": "file", "src": [], "disabled": true }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/doctors/{{doctorId}}/patients",
              "host": ["{{baseUrl}}"],
              "path": ["doctors", "{{doctorId}}", "patients"]
            }
          }
        },
        {
          "name": "Delete Patient from Doctor's List (PDF Page 2)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/doctors/{{doctorId}}/patients/{{patientId}}",
              "host": ["{{baseUrl}}"],
              "path": ["doctors", "{{doctorId}}", "patients", "{{patientId}}"]
            }
          }
        },
        {
          "name": "Update Doctor",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "phone", "value": "+880 1711 000111", "type": "text" },
                { "key": "status", "value": "Active", "type": "text" },
                { "key": "photo", "type": "file", "src": [], "disabled": true }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/doctors/{{doctorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["doctors", "{{doctorId}}"]
            }
          }
        },
        {
          "name": "Delete Doctor",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/doctors/{{doctorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["doctors", "{{doctorId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "03. Patients",
      "item": [
        {
          "name": "Get All Patients (Master list, search & filters)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/patients?page=1&limit=10&condition=all&status=all",
              "host": ["{{baseUrl}}"],
              "path": ["patients"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "condition", "value": "all" },
                { "key": "status", "value": "all" }
              ]
            }
          }
        },
        {
          "name": "Get Single Patient By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/patients/{{patientId}}",
              "host": ["{{baseUrl}}"],
              "path": ["patients", "{{patientId}}"]
            }
          }
        },
        {
          "name": "Register New Patient",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "Mahmud Hasan", "type": "text" },
                { "key": "age", "value": "38", "type": "text" },
                { "key": "gender", "value": "Male", "type": "text" },
                { "key": "condition", "value": "Diabetes Type 2", "type": "text" },
                { "key": "phone", "value": "+880 1822 334455", "type": "text" },
                { "key": "doctorId", "value": "{{doctorId}}", "type": "text" },
                { "key": "status", "value": "Admitted", "type": "text" },
                { "key": "photo", "type": "file", "src": [], "disabled": true }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/patients",
              "host": ["{{baseUrl}}"],
              "path": ["patients"]
            }
          }
        },
        {
          "name": "Update Patient",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "condition", "value": "Diabetes Type 2 - Controlled", "type": "text" },
                { "key": "status", "value": "Followup", "type": "text" },
                { "key": "photo", "type": "file", "src": [], "disabled": true }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/patients/{{patientId}}",
              "host": ["{{baseUrl}}"],
              "path": ["patients", "{{patientId}}"]
            }
          }
        },
        {
          "name": "Delete Patient",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/patients/{{patientId}}",
              "host": ["{{baseUrl}}"],
              "path": ["patients", "{{patientId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "04. Dashboard & Analytics",
      "item": [
        {
          "name": "Get Dashboard Statistics (KPIs)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/dashboard/stats",
              "host": ["{{baseUrl}}"],
              "path": ["dashboard", "stats"]
            }
          }
        },
        {
          "name": "Get Patients Overview Trend",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/dashboard/patients-overview",
              "host": ["{{baseUrl}}"],
              "path": ["dashboard", "patients-overview"]
            }
          }
        },
        {
          "name": "Get Doctors by Specialty Breakdown",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/dashboard/specialty-stats",
              "host": ["{{baseUrl}}"],
              "path": ["dashboard", "specialty-stats"]
            }
          }
        },
        {
          "name": "Get Patients per Doctor Analytics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/dashboard/patients-per-doctor",
              "host": ["{{baseUrl}}"],
              "path": ["dashboard", "patients-per-doctor"]
            }
          }
        }
      ]
    }
  ]
}

